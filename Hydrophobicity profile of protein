import matplotlib.pyplot as plt
# Шкала гидрофобности (по Кайту-Дулиттлу, значения для каждого остатка)
hydrophobicity_scale = {
    'A': 1.8, 'R': -4.5, 'N': -3.5, 'D': -3.5, 'C': 2.5,
    'Q': -3.5, 'E': -3.5, 'G': -0.4, 'H': -3.2, 'I': 4.5,
    'L': 3.8, 'K': -3.9, 'M': 1.9, 'F': 2.8, 'P': -1.6,
    'S': -0.8, 'T': -0.7, 'W': -0.9, 'Y': -1.3, 'V': 4.2
}
def hydrophobicity_profile(sequence, window=9):
    profile = []
    for i in range(len(sequence) - window + 1): # сюда будем сохранять результат — список средних значений
        window_seq = sequence[i:i+window] #берём окно
        #Присваиваем значение 0 аминокислотам, которых нет в шкале
        values = [hydrophobicity_scale.get(aa, 0) for aa in window_seq] # числа для каждого остатка
        avg = sum(values) / len(values) # среднее по окну
        profile.append(avg) # сохраняем
    return profile

def plot_profile(sequence, window=9):
    """
    Строит график гидрофобного профиля.
    """
    profile = hydrophobicity_profile(sequence, window)
    plt.figure(figsize=(12, 5))
    plt.plot(profile, color='blue', linewidth=1.5)
    plt.axhline(y=0, color='gray', linestyle='--', linewidth=0.8)
    plt.xlabel('Позиция в последовательности (центр окна)')
    plt.ylabel('Средняя гидрофобность')
    plt.title(f'Гидрофобный профиль белка (окно={window})')
    plt.grid(True, alpha=0.3)
    plt.show()
# Пример: короткий белок (можно заменить на свою последовательность)
sequence = "MVLSPADKTNVKAAWGKVGAHAGEYGAEALERMFLSFPTTKTYFPHF"
plot_profile(sequence, window=9)
